#version 450 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) restrict readonly buffer InputBuffer {
    float data[];
} inputBuffer;

layout(std430, binding = 1) restrict buffer AccumBuffer {
    float data[];
} accumBuffer;

layout(push_constant) uniform PushConstants {
    uint layer_idx;
    uint batch_size;
    uint seq_pos;
    uint max_seq_len;
    uint d_model;
    uint num_heads;
    uint head_dim;
    uint d_ff;
    uint stride_0;
    uint stride_1;
    uint start_pos;
    uint reserved[5];
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint cols = pc.d_model;
    uint dst_base = pc.stride_0;

    if (gid >= cols) {
        return;
    }

    float value = inputBuffer.data[gid];
    accumBuffer.data[dst_base + gid] += value * value;
}