/**
 * @file rmsnorm_bf16.comp
 * @brief RMSNorm compute shader (BF16 precision).
 *
 * Performs RMSNorm: output = (input / RMS(input)) * scale
 * Input/weights/output are BF16 packed in uint[]. Computation in FP32.
 *
 * Parallelization: One workgroup per batch sample.
 */
#version 450 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) restrict readonly buffer InputBuffer {
    uint data[];
} inputBuffer;

layout(std430, binding = 1) restrict readonly buffer ScaleBuffer {
    uint data[];
} scaleBuffer;

layout(std430, binding = 2) restrict writeonly buffer OutputBuffer {
    uint data[];
} outputBuffer;

layout(push_constant) uniform PushConstants {
    uint layer_idx;
    uint batch_size;
    uint seq_pos;
    uint max_seq_len;
    uint d_model;
    uint num_heads;
    uint head_dim;
    uint d_ff;
    uint stride_0;
    uint stride_1;
    uint start_pos;     // first absolute pos of this batch
    uint reserved[5];
} pc;

float bf16_unpack(uint bf16_val) {
    return uintBitsToFloat(bf16_val << 16);
}

uint bf16_pack(float fp32_val) {
    uint bits = floatBitsToUint(fp32_val);
    return (bits + 0x7FFFu) >> 16;
}

shared float shared_sum[256];

void main() {
    uint local_id = gl_LocalInvocationID.x;
    uint sample_idx = gl_WorkGroupID.x;

    if (sample_idx >= pc.batch_size) return;

    uint d_model = pc.d_model;
    uint stride = (pc.stride_0 > 0u) ? pc.stride_0 : d_model;
    uint base_offset = sample_idx * stride;

    // Phase 1: sum of squares
    float local_sum = 0.0;
    for (uint d = local_id; d < d_model; d += 256u) {
        uint idx = base_offset + d;
        uint word = inputBuffer.data[idx >> 1];
        float val = bf16_unpack(((idx & 1u) == 0u) ? (word & 0xFFFFu) : (word >> 16));
        local_sum += val * val;
    }
    shared_sum[local_id] = local_sum;
    barrier();

    for (uint s = 128u; s > 0u; s >>= 1) {
        if (local_id < s) {
            shared_sum[local_id] += shared_sum[local_id + s];
        }
        barrier();
    }

    // Phase 2: normalize and store BF16 pairs
    // Gemma3 rmsnorm_delta: output = (input / rms) * (1.0 + weight)
    float rms = sqrt(shared_sum[0] / float(d_model) + 1e-6);  /* Gemma3: rms_norm_eps=1e-6 */

    for (uint d = local_id * 2u; d < d_model; d += 512u) {
        uint idx0 = base_offset + d;
        uint w0 = inputBuffer.data[idx0 >> 1];
        uint s0 = scaleBuffer.data[d >> 1];
        float val0 = bf16_unpack((d & 1u) == 0u ? (w0 & 0xFFFFu) : (w0 >> 16));
        float scale0 = bf16_unpack(s0 & 0xFFFFu);
        float result0 = (val0 / rms) * (1.0 + scale0);  /* rmsnorm_delta */

        float result1 = 0.0;
        if (d + 1u < d_model) {
            uint idx1 = base_offset + d + 1u;
            uint w1 = inputBuffer.data[idx1 >> 1];
            float val1 = bf16_unpack((idx1 & 1u) == 0u ? (w1 & 0xFFFFu) : (w1 >> 16));
            float scale1 = bf16_unpack(s0 >> 16);
            result1 = (val1 / rms) * (1.0 + scale1);  /* rmsnorm_delta */
        }

        outputBuffer.data[(base_offset + d) >> 1] = (bf16_pack(result1) << 16) | (bf16_pack(result0) & 0xFFFFu);
    }
}
