/**
 * @file gemv_f32.comp
 * @brief Matrix-Vector multiplication shader (F32 precision).
 *
 * Computes y[d_out] = W[d_out, d_in] @ x[d_in]
 * Used for single-token decoding (batch_size=1).
 *
 * Parallelization: One workgroup per output row (WG.x = output element index).
 *   256 threads stride across d_in, each accumulating a partial sum, then
 *   parallel tree reduction via shared memory (8 barriers).
 *   Dispatch: (d_out, 1, 1) workgroups.
 */
#version 450 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) restrict readonly buffer InputBuffer {
    float data[];
} inputBuffer;

layout(std430, binding = 1) restrict readonly buffer WeightBuffer {
    float data[];
} weightBuffer;

layout(std430, binding = 2) restrict writeonly buffer OutputBuffer {
    float data[];
} outputBuffer;

layout(push_constant) uniform PushConstants {
    uint layer_idx;
    uint batch_size;
    uint seq_pos;
    uint max_seq_len;
    uint d_model;       // d_in
    uint num_heads;     // d_out
    uint head_dim;
    uint d_ff;
    uint stride_0;      // weight row stride (d_in)
    uint stride_1;
    uint start_pos;
    uint reserved[5];
} pc;

shared float sh_partial[256];

void main() {
    uint out_row  = gl_WorkGroupID.x;
    uint local_id = gl_LocalInvocationID.x;

    uint d_in          = pc.d_model;
    uint d_out         = pc.num_heads;
    uint weight_stride = (pc.stride_0 > 0u) ? pc.stride_0 : d_in;

    if (out_row >= d_out) return;

    uint row_base = out_row * weight_stride;
    float acc = 0.0;

    for (uint i = local_id; i < d_in; i += 256u) {
        acc += weightBuffer.data[row_base + i] * inputBuffer.data[i];
    }

    sh_partial[local_id] = acc;
    barrier();

    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (local_id < s) {
            sh_partial[local_id] += sh_partial[local_id + s];
        }
        barrier();
    }

    if (local_id == 0u) {
        outputBuffer.data[out_row] = sh_partial[0u];
    }
}

