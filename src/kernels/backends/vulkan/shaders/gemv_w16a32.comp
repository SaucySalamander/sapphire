/**
 * @file gemv_w16a32.comp
 * @brief Mixed-precision GEMV: F32 activations × BF16 weights → F32 output.
 *
 * This shader is the critical path for VRAM-constrained models (4B+).
 * By keeping weights as BF16 on the GPU we halve weight storage (~6.3 GB
 * vs ~12.6 GB F32 for Gemma 4B), keeping all projection weights in VRAM
 * and eliminating the catastrophic PCIe spill that occurs when they overflow
 * the 8 GB budget.
 *
 * Binding layout matches PROJECTION layout (same as gemv_f32.comp):
 *   binding 0 : InputBuffer  – F32 activation vector  [d_in]
 *   binding 1 : WeightBuffer – BF16 packed as uint[]   [d_out × d_in / 2 uint32 words]
 *   binding 2 : OutputBuffer – F32 result vector       [d_out]
 *
 * BF16 packing: two uint16 elements per uint32 word.
 *   word = weightBuffer.data[(row_base + i) >> 1]
 *   element i (even) → bits [15:0]   → uintBitsToFloat(word_lo << 16)
 *   element i (odd)  → bits [31:16]  → uintBitsToFloat(word & 0xFFFF0000)
 *
 * Parallelisation: one workgroup per output row, 256 threads stride across
 * d_in and accumulate F32 partial sums, then tree-reduce in shared memory.
 * Dispatch: (d_out, 1, 1) workgroups.
 */

#version 450 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) restrict readonly buffer InputBuffer {
    float data[];
} inputBuffer;

layout(std430, binding = 1) restrict readonly buffer WeightBuffer {
    uint data[];  /* BF16 pairs: element 2k in low 16 bits, element 2k+1 in high 16 bits */
} weightBuffer;

layout(std430, binding = 2) restrict writeonly buffer OutputBuffer {
    float data[];
} outputBuffer;

layout(push_constant) uniform PushConstants {
    uint layer_idx;
    uint batch_size;
    uint seq_pos;
    uint max_seq_len;
    uint d_model;       /* d_in  – input dimension                    */
    uint num_heads;     /* d_out – output dimension                   */
    uint head_dim;
    uint d_ff;
    uint stride_0;      /* weight row stride in elements (defaults to d_in) */
    uint stride_1;
    uint start_pos;
    uint reserved[5];
} pc;

/* BF16 → F32 helpers.
 * A BF16 value is the upper 16 bits of the corresponding F32 bit pattern. */
float bf16_lo(uint packed) {
    return uintBitsToFloat((packed & 0xFFFFu) << 16u);
}
float bf16_hi(uint packed) {
    return uintBitsToFloat(packed & 0xFFFF0000u);
}

shared float sh_partial[256];

void main() {
    uint out_row  = gl_WorkGroupID.x;
    uint local_id = gl_LocalInvocationID.x;

    uint d_in          = pc.d_model;
    uint d_out         = pc.num_heads;
    uint weight_stride = (pc.stride_0 > 0u) ? pc.stride_0 : d_in;

    if (out_row >= d_out) return;

    uint row_base = out_row * weight_stride;  /* element index of row start */
    float acc     = 0.0;

    /* Phase 1: Strided dot product.
     * Process two BF16 weight elements per iteration (one uint32 load).
     * Each thread handles one uint32 word per outer loop step.
     * Thread t covers word indices: t, t+256, t+512, ...
     * Corresponding element indices: 2t, 2t+1, 2t+512, 2t+513, ... */
    uint i = local_id * 2u;
    for (; i + 1u < d_in; i += 256u * 2u) {
        uint w_word = weightBuffer.data[(row_base + i) >> 1u];
        acc += bf16_lo(w_word) * inputBuffer.data[i];
        acc += bf16_hi(w_word) * inputBuffer.data[i + 1u];
    }
    /* Tail: handle the last element when d_in is odd. */
    if (i < d_in) {
        uint w_word = weightBuffer.data[(row_base + i) >> 1u];
        float w_val = ((i & 1u) == 0u) ? bf16_lo(w_word) : bf16_hi(w_word);
        acc += w_val * inputBuffer.data[i];
    }

    sh_partial[local_id] = acc;
    barrier();

    /* Phase 2: Parallel tree reduction in shared memory (8 steps for 256 threads). */
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (local_id < s) {
            sh_partial[local_id] += sh_partial[local_id + s];
        }
        barrier();
    }

    /* Phase 3: Write scalar F32 result. */
    if (local_id == 0u) {
        outputBuffer.data[out_row] = sh_partial[0u];
    }
}
